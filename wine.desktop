# This file is needed because it allows the system to launch .exe automatically via wine.
# Once this file is installed, these two commands are run to update and set wine by default for .exe in the file explorer: update-desktop-database ~/.local/share/applications && xdg-mime default wine.desktop application/x-ms-dos-executable
[Desktop Entry]
Name=Wine
Comment=Run Windows applications
Exec=wine %f
Terminal=false
Type=Application
MimeType=application/x-ms-dos-executable
NoDisplay=true
